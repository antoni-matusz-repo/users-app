# Skopiuj do .env i dostosuj w razie potrzeby.
# Wartości domyślne odpowiadają serwisowi "db" z docker/docker-compose.yml.
DATABASE_URL="postgresql://users_app:users_app@localhost:5432/users_app?schema=public"

# Osobna baza na potrzeby testów integracyjnych (tests/unit), patrz docker/init/01-create-test-db.sql
TEST_DATABASE_URL="postgresql://users_app:users_app@localhost:5432/users_app_test?schema=public"

# Better Auth — wygeneruj własny sekret: `openssl rand -base64 32`
BETTER_AUTH_SECRET="wygeneruj-wlasny-sekret"
BETTER_AUTH_URL="http://localhost:3000"
